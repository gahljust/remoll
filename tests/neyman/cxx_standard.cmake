# cmake -P tests/neyman/cxx_standard.cmake
set(PROJECT_NAME remoll)
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/modules/CMakeEnv.cmake")
set(ROOT_VERSION 6.0)
foreach(level 14 17 20)
  set(CMAKE_CXX_STANDARD ${level})
  set_cxx_std("-pipe -pthread")
  if(NOT CMAKE_CXX_STANDARD EQUAL level)
    message(FATAL_ERROR "ROOT fallback changed C++${level}")
  endif()
endforeach()
set(CMAKE_CXX_STANDARD 11)
set_cxx_std("-pipe -pthread")
if(NOT CMAKE_CXX_STANDARD EQUAL 14)
  message(FATAL_ERROR "Plan reader requires at least C++14")
endif()
message(STATUS "PASS ROOT fallback preserves C++14 or newer")
