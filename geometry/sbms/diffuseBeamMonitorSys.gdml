<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE gdml [
	<!ENTITY matrices SYSTEM "showerMaxMatrices.xml">
	<!ENTITY materials SYSTEM "showerMaxMaterials.xml">
    ]>

<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">


<define>
    <constant name="detBox_inner_radius" value="1500"/>
    <constant name="detBox_outer_radius" value="1900"/>



    &matrices;
</define>

&materials;

<solids>
    <tube name="solid_DBM_boundingBox" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin="0.99*detBox_inner_radius" rmax="1.01*detBox_outer_radius" z="1.01*210"/>
    <tube name="solid_DBM_singleDet_boundingBox" lunit="mm" aunit="rad" startphi="-pi/(14*2)" deltaphi="pi/14" rmin="detBox_inner_radius" rmax="detBox_outer_radius" z="210"/>

    <!--Radiator and PMT-->
    <box lunit="mm" name="solid_DBM_radiator_quartz" x="100" y="76" z="10"/>
    <tube name="solid_DBM_pmt_window" rmin="0" rmax="38.1" z="3.0" deltaphi="2*pi" startphi="0" aunit="rad" lunit="mm"/>
    <tube name="solid_DBM_pmt_cathode" rmin="0" rmax="38.1" z="3e-06" deltaphi="2*pi" startphi="0" aunit="rad" lunit="mm"/>

    <!--PMT Housing-->
    <cone name="solid_pmt_housing" rmin1="42"  rmax1="45.0" rmin2="42" rmax2="45.0"  z="213.0" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>
	<cone name="solid_pmt_housing_lid" rmin1="0"  rmax1="46.0" rmin2="0" rmax2="46.0"  z="3.0" startphi="0" deltaphi="360" aunit="deg" lunit="mm"/>

</solids>


<structure>


    <volume name="DBM_quartz_logic_0">
        <materialref ref="Quartz"/>
        <solidref ref = "solid_DBM_radiator_quartz"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="81000"/>
    </volume>

    <volume name="DBM_quartzpmt_cathode_logic_0">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="82000"/>
    </volume>

    <volume name="DBM_barepmt_cathode_logic_0">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="83000"/>
    </volume>

    <volume name="DBM_quartz_logic_2">
        <materialref ref="Quartz"/>
        <solidref ref = "solid_DBM_radiator_quartz"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="81001"/>
    </volume>

    <volume name="DBM_quartzpmt_cathode_logic_2">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="82001"/>
    </volume>

    <volume name="DBM_barepmt_cathode_logic_2">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="83001"/>
    </volume>

    <volume name="DBM_quartz_logic_2">
        <materialref ref="Quartz"/>
        <solidref ref = "solid_DBM_radiator_quartz"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="81002"/>
    </volume>

    <volume name="DBM_quartzpmt_cathode_logic_2">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="82002"/>
    </volume>

    <volume name="DBM_barepmt_cathode_logic_2">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="83002"/>
    </volume>

    <volume name="DBM_quartz_logic_3">
        <materialref ref="Quartz"/>
        <solidref ref = "solid_DBM_radiator_quartz"/>
        <auxiliary auxtype="Alpha" auxvalue="0.3"/>
        <auxiliary auxtype="Color" auxvalue="green"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartz" />
		<auxiliary auxtype="DetNo" auxvalue="81003"/>
    </volume>

    <volume name="DBM_quartzpmt_cathode_logic_3">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="82003"/>
    </volume>

    <volume name="DBM_barepmt_cathode_logic_3">
        <materialref ref="Cathode"/>
        <solidref ref = "solid_DBM_pmt_cathode"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="yellow"/>
        <auxiliary auxtype="SensDet" auxvalue="diffuseBeamMonitorQuartzPMT" />
		<auxiliary auxtype="DetNo" auxvalue="83003"/>
    </volume>




    <volume name="DBM_pmt_window_logic">
        <materialref ref="Quartz"/>
        <solidref ref = "solid_DBM_pmt_window"/>
        <auxiliary auxtype="Alpha" auxvalue="1.0"/>
        <auxiliary auxtype="Color" auxvalue="blue"/>
    </volume>


    <volume name="logic_pmt_housing">
		<materialref ref="G4_Al"/>
		<solidref ref="solid_pmt_housing"/>
		<auxiliary auxtype="Color" auxvalue="grey"/>
		<auxiliary auxtype="Alpha" auxvalue="0.5"/>
	    </volume>

    <volume name="logic_pmt_housing_lid">
		<materialref ref="G4_Al"/>
		<solidref ref="solid_pmt_housing_lid"/>
		<auxiliary auxtype="Color" auxvalue="grey"/>
        <auxiliary auxtype="Alpha" auxvalue="0.5"/>
	    </volume>



    <!--Individual Detectors-->
    <volume name="DBM_singleDet_boundingBox_logic_0">
        <materialref ref="Air"/>
        <solidref ref = "solid_DBM_singleDet_boundingBox"/>
        <auxiliary auxtype="Alpha" auxvalue="0.0"/>

        <physvol name="DBM_quartz_phys_0">
            <volumeref ref="DBM_quartz_logic_0" />
            <position name="radiator_quartz_pos_0" unit="mm" x="detBox_inner_radius + 100/2" y="0" z="53.52" />
            <rotation name="radiator_quartz_rot_0" unit="deg" x="0" y="0" z="0" />
            </physvol>

        <physvol name="DBM_quartzpmt_cathode_phys_0">
            <volumeref ref="DBM_quartzpmt_cathode_logic_0" />
            <position name="DBM_quartzCathode_pos_0" unit="mm" x="detBox_inner_radius + 100 + 3 + 3e-06/2" y="0" z="53.52" />
            <rotation name="DBM_quartzCathode_rot_0" unit="deg" x="0" y="90" z="0" />
            </physvol>
        
        <physvol name="DBM_barepmt_cathode_phys_0">
            <volumeref ref="DBM_barepmt_cathode_logic_0" />
            <position name="DBM_bareCathode_pos_0" unit="mm" x="detBox_inner_radius + 100 + 3 + 3e-06/2" y="0" z="-53.52" />
            <rotation name="DBM_bareCathode_rot_0" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="DBM_quartzpmt_window_phys">
            <volumeref ref="DBM_pmt_window_logic" />
            <position name="DBM_quartzWindow_pos_0" unit="mm" x="detBox_inner_radius + 100 + 3/2" y="0" z="53.52" />
            <rotation name="DBM_quartzWindow_rot_0" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="DBM_barepmt_window_phys">
            <volumeref ref="DBM_pmt_window_logic" />
            <position name="DBM_bareWindow_pos_0" unit="mm" x="detBox_inner_radius + 100 + 3/2" y="0" z="-53.52" />
            <rotation name="DBM_bareWindow_rot_0" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="barepmt_housing_phys">
			<volumeref ref="logic_pmt_housing"/>
			<position name="pos_barepmt_housing" x="detBox_inner_radius + 100 + 213/2" y="0" z="-53.52"/>
			<rotation name="rot_barepmt_housing" unit="deg" x="0" y="90" z="0"/>
		    </physvol>

		<physvol name="barepmt_housing_lid_phys">
			<volumeref ref="logic_pmt_housing_lid"/>
			<position name="pos_barepmt_housing_lid" x="detBox_inner_radius + 100 + 213 + 3/2" y="0" z="-53.52"/>
			<rotation name="rot_barepmt_housing_lid" unit="deg" x="0" y="90" z="0" />
		    </physvol>

        <physvol name="quartzpmt_housing_phys">
			<volumeref ref="logic_pmt_housing"/>
			<position name="pos_quartzpmt_housing" x="detBox_inner_radius + 100 + 213/2" y="0" z="53.52"/>
			<rotation name="rot_quartzpmt_housing" unit="deg" x="0" y="90" z="0"/>
		    </physvol>

		<physvol name="quartzpmt_housing_lid_phys">
			<volumeref ref="logic_pmt_housing_lid"/>
			<position name="pos_quartzpmt_housing_lid" x="detBox_inner_radius + 100 + 213 + 3/2" y="0" z="53.52"/>
			<rotation name="rot_quartzpmt_housing_lid" unit="deg" x="0" y="90" z="0" />
		    </physvol>

    </volume>


    <volume name="DBM_singleDet_boundingBox_logic_1">
        <materialref ref="Air"/>
        <solidref ref = "solid_DBM_singleDet_boundingBox"/>
        <auxiliary auxtype="Alpha" auxvalue="0.0"/>

        <physvol name="DBM_quartz_phys_1">
            <volumeref ref="DBM_quartz_logic_1" />
            <position name="radiator_quartz_pos_1" unit="mm" x="detBox_inner_radius + 100/2" y="0" z="53.52" />
            <rotation name="radiator_quartz_rot_1" unit="deg" x="0" y="0" z="0" />
            </physvol>

        <physvol name="DBM_quartzpmt_cathode_phys_1">
            <volumeref ref="DBM_quartzpmt_cathode_logic_1" />
            <position name="DBM_quartzCathode_pos_1" unit="mm" x="detBox_inner_radius + 100 + 3 + 3e-06/2" y="0" z="53.52" />
            <rotation name="DBM_quartzCathode_rot_1" unit="deg" x="0" y="90" z="0" />
            </physvol>
        
        <physvol name="DBM_barepmt_cathode_phys_1">
            <volumeref ref="DBM_barepmt_cathode_logic_1" />
            <position name="DBM_bareCathode_pos_1" unit="mm" x="detBox_inner_radius + 100 + 3 + 3e-06/2" y="0" z="-53.52" />
            <rotation name="DBM_bareCathode_rot_1" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="DBM_quartzpmt_window_phys">
            <volumeref ref="DBM_pmt_window_logic" />
            <position name="DBM_quartzWindow_pos" unit="mm" x="detBox_inner_radius + 100 + 3/2" y="0" z="53.52" />
            <rotation name="DBM_quartzWindow_rot" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="DBM_barepmt_window_phys">
            <volumeref ref="DBM_pmt_window_logic" />
            <position name="DBM_bareWindow_pos" unit="mm" x="detBox_inner_radius + 100 + 3/2" y="0" z="-53.52" />
            <rotation name="DBM_bareWindow_rot" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="barepmt_housing_phys">
			<volumeref ref="logic_pmt_housing"/>
			<position name="pos_barepmt_housing" x="detBox_inner_radius + 100 + 213/2" y="0" z="-53.52"/>
			<rotation name="rot_barepmt_housing" unit="deg" x="0" y="90" z="0"/>
		    </physvol>

		<physvol name="barepmt_housing_lid_phys">
			<volumeref ref="logic_pmt_housing_lid"/>
			<position name="pos_barepmt_housing_lid" x="detBox_inner_radius + 100 + 213 + 3/2" y="0" z="-53.52"/>
			<rotation name="rot_barepmt_housing_lid" unit="deg" x="0" y="90" z="0" />
		    </physvol>

        <physvol name="quartzpmt_housing_phys">
			<volumeref ref="logic_pmt_housing"/>
			<position name="pos_quartzpmt_housing" x="detBox_inner_radius + 100 + 213/2" y="0" z="53.52"/>
			<rotation name="rot_quartzpmt_housing" unit="deg" x="0" y="90" z="0"/>
		    </physvol>

		<physvol name="quartzpmt_housing_lid_phys">
			<volumeref ref="logic_pmt_housing_lid"/>
			<position name="pos_quartzpmt_housing_lid" x="detBox_inner_radius + 100 + 213 + 3/2" y="0" z="53.52"/>
			<rotation name="rot_quartzpmt_housing_lid" unit="deg" x="0" y="90" z="0" />
		    </physvol>

    </volume>


    <volume name="DBM_singleDet_boundingBox_logic_2">
        <materialref ref="Air"/>
        <solidref ref = "solid_DBM_singleDet_boundingBox"/>
        <auxiliary auxtype="Alpha" auxvalue="0.0"/>

        <physvol name="DBM_quartz_phys_2">
            <volumeref ref="DBM_quartz_logic_2" />
            <position name="radiator_quartz_pos_2" unit="mm" x="detBox_inner_radius + 100/2" y="0" z="53.52" />
            <rotation name="radiator_quartz_rot_2" unit="deg" x="0" y="0" z="0" />
            </physvol>

        <physvol name="DBM_quartzpmt_cathode_phys_2">
            <volumeref ref="DBM_quartzpmt_cathode_logic_2" />
            <position name="DBM_quartzCathode_pos_2" unit="mm" x="detBox_inner_radius + 100 + 3 + 3e-06/2" y="0" z="53.52" />
            <rotation name="DBM_quartzCathode_rot_2" unit="deg" x="0" y="90" z="0" />
            </physvol>
        
        <physvol name="DBM_barepmt_cathode_phys_2">
            <volumeref ref="DBM_barepmt_cathode_logic_2" />
            <position name="DBM_bareCathode_pos_2" unit="mm" x="detBox_inner_radius + 100 + 3 + 3e-06/2" y="0" z="-53.52" />
            <rotation name="DBM_bareCathode_rot_2" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="DBM_quartzpmt_window_phys">
            <volumeref ref="DBM_pmt_window_logic" />
            <position name="DBM_quartzWindow_pos" unit="mm" x="detBox_inner_radius + 100 + 3/2" y="0" z="53.52" />
            <rotation name="DBM_quartzWindow_rot" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="DBM_barepmt_window_phys">
            <volumeref ref="DBM_pmt_window_logic" />
            <position name="DBM_bareWindow_pos" unit="mm" x="detBox_inner_radius + 100 + 3/2" y="0" z="-53.52" />
            <rotation name="DBM_bareWindow_rot" unit="deg" x="0" y="90" z="0" />
            </physvol>

        <physvol name="barepmt_housing_phys">
			<volumeref ref="logic_pmt_housing"/>
			<position name="pos_barepmt_housing" x="detBox_inner_radius + 100 + 213/2" y="0" z="-53.52"/>
			<rotation name="rot_barepmt_housing" unit="deg" x="0" y="90" z="0"/>
		    </physvol>

		<physvol name="barepmt_housing_lid_phys">
			<volumeref ref="logic_pmt_housing_lid"/>
			<position name="pos_barepmt_housing_lid" x="detBox_inner_radius + 100 + 213 + 3/2" y="0" z="-53.52"/>
			<rotation name="rot_barepmt_housing_lid" unit="deg" x="0" y="90" z="0" />
		    </physvol>

        <physvol name="quartzpmt_housing_phys">
			<volumeref ref="logic_pmt_housing"/>
			<position name="pos_quartzpmt_housing" x="detBox_inner_radius + 100 + 213/2" y="0" z="53.52"/>
			<rotation name="rot_quartzpmt_housing" unit="deg" x="0" y="90" z="0"/>
		    </physvol>

		<physvol name="quartzpmt_housing_lid_phys">
			<volumeref ref="logic_pmt_housing_lid"/>
			<position name="pos_quartzpmt_housing_lid" x="detBox_inner_radius + 100 + 213 + 3/2" y="0" z="53.52"/>
			<rotation name="rot_quartzpmt_housing_lid" unit="deg" x="0" y="90" z="0" />
		    </physvol>

    </volume>



    <!--Mother Volume-->

    <volume name="diffuseBeamMonitorMother">
        <materialref ref="Air"/>
        <solidref ref = "solid_DBM_boundingBox"/>
        <auxiliary auxtype="Alpha" auxvalue="0.1"/>
        <!--<auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorBoundingBox" />
		<auxiliary auxtype="DetNo" auxvalue="80000"/>-->

        <physvol name="DBM_singleDet_boundingBox_phys_0">
            <volumeref ref="DBM_singleDet_boundingBox_logic_0"/>
            <position name="pos_DBM_singleDet_2" x="0" y="0" z="0"/>
            <rotation name="rot_DBM_singleDet_2" unit="radian" x="0" y="0" z="0" />
        </physvol>

        <physvol name="DBM_singleDet_boundingBox_phys_1">
            <volumeref ref="DBM_singleDet_boundingBox_logic_1"/>
            <position name="pos_DBM_singleDet_2" x="0" y="0" z="0"/>
            <rotation name="rot_DBM_singleDet_2" unit="radian" x="0" y="0" z="2*pi/14" />
        </physvol>

        <physvol name="DBM_singleDet_boundingBox_phys_2">
            <volumeref ref="DBM_singleDet_boundingBox_logic_2"/>
            <position name="pos_DBM_singleDet_2" x="0" y="0" z="0"/>
            <rotation name="rot_DBM_singleDet_2" unit="radian" x="0" y="0" z="4*pi/14" />
        </physvol>



    </volume>


</structure>


<setup name="diffuseBeamMonitorWorld" version="1.0">
    <world ref="diffuseBeamMonitorMother"/>
</setup>

</gdml>