<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE gdml [
	<!ENTITY matrices SYSTEM "showerMaxMatrices.xml">
	<!ENTITY materials SYSTEM "showerMaxMaterials.xml">
    ]>

<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">


<define>
    <constant name="detBox_inner_radius" value="1500"/>
    <constant name="detBox_outer_radius" value="1900"/>



    &matrices;
</define>

&materials;

<solids>
    <tube name="solidDBM_bounding_box" lunit="mm" aunit="rad" startphi="0" deltaphi="2*pi" rmin="detBox_inner_radius" rmax="detBox_outer_radius" z="150"/>


</solids>


<structure>


    <!--Mother Volume-->

    <volume name="diffuseBeamMonitorMother">
        <materialref ref="Air"/>
        <solidref ref = "solidDBM_bounding_box"/>
        <auxiliary auxtype="Alpha" auxvalue="0.0"/>
        <!--<auxiliary auxtype="SensDet" auxvalue="largeAngleMonitorBoundingBox" />
		<auxiliary auxtype="DetNo" auxvalue="80000"/>-->

    </volume>


</structure>


<setup name="diffuseBeamMonitorWorld" version="1.0">
    <world ref="diffuseBeamMonitorMother"/>
</setup>

</gdml>